<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDFDFD">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <ImageView
            android:id="@+id/imgMuseumDetail"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_gallery" />

        <TextView
            android:id="@+id/txtDetailName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="Müze Adı"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#2C3E50" />

        <RatingBar
            android:id="@+id/museumRatingBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:numStars="5"
            android:stepSize="1.0"
            android:layout_marginTop="10dp"
            android:progressTint="#FFD700" />


        <View
            android:layout_width="60dp"
            android:layout_height="3dp"
            android:layout_marginTop="10dp"
            android:background="#FF5252" />

        <TextView
            android:id="@+id/txtDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Ege'nin kalbinde yer alan bu tarihi mekan, binlerce yıllık medeniyetlerin izlerini taşımaktadır. Arkeolojik kazılarla gün ışığına çıkarılan eserler, ziyaretçilerini geçmişe doğru unutulmaz bir yolculuğa çıkarmaktadır."
            android:textSize="17sp"
            android:lineSpacingExtra="5dp"
            android:textColor="#555" />

        <Button
            android:id="@+id/btnMap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Yol Tarifi Al"
            android:backgroundTint="#4CAF50" />

        <Button
            android:id="@+id/btnWebsite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Resmi Web Sitesini Gör"
            android:layout_marginTop="10dp"
            android:backgroundTint="#2196F3" />

    </LinearLayout>
</ScrollView>